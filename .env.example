# Development Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL - MUST be NEXT_PUBLIC_ prefix for frontend to access in production
# For local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# For Vercel/production deployment, set to your deployed backend URL:
# NEXT_PUBLIC_API_BASE_URL=https://your-backend-url.herokuapp.com
# or
# NEXT_PUBLIC_API_BASE_URL=https://your-backend-url.railway.app

# Groq API Key (for LLM queries)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Backend environment variables
# DATABASE_URL=postgresql://user:password@localhost/dbname
